    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.4.0",
