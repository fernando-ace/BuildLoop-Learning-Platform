# Hosted PostgreSQL. Production mode fails closed when this is missing.
# Runtime URL may use the provider's pooler. Migrations prefer DATABASE_MIGRATION_URL, then provider direct/unpooled URL variables, then DATABASE_URL.
DATABASE_URL=postgresql://buildloop:change-me@localhost:5432/buildloop
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=5

# Explicit app environment. Vercel uses VERCEL_ENV when this is omitted.
BUILDLOOP_ENVIRONMENT=development
BUILDLOOP_RELEASE=local

# Optional for local development; both DSNs are required for hosted readiness. DSNs are public project identifiers, not auth tokens.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_BUILDLOOP_ENVIRONMENT=development
NEXT_PUBLIC_BUILDLOOP_RELEASE=local

# Better Auth. Use a fresh random value of at least 32 characters in each environment.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Optional for local development and Preview. Production readiness requires this for live Builder generation.
OPENAI_API_KEY=
BUILDLOOP_OPENAI_MODEL=gpt-4.1-mini
BUILDLOOP_BUILDER_MODE=

# Optional for local development and Preview. Production readiness requires this for account email. Use a verified sender.
RESEND_API_KEY=
EMAIL_FROM=BuildLoop <invites@example.com>

# Preview only: skip email verification for accounts inside the Vercel SSO-protected staging deployment.
# Keep empty unless Vercel Authentication is enabled for every preview URL. This does not enable invitations or password-reset email.
BUILDLOOP_PREVIEW_ALLOW_UNVERIFIED_SIGNUPS=

# Development browser tests only. Never set these in a production deployment.
BUILDLOOP_AUTH_MODE=
BUILDLOOP_TEST_AUTH_SECRET=
