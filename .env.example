# Hosted PostgreSQL. Production mode fails closed when this is missing.
DATABASE_URL=postgresql://buildloop:change-me@localhost:5432/buildloop
DATABASE_POOL_MAX=10

# Better Auth. Use a fresh random value of at least 32 characters in each environment.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Optional Builder provider configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
BUILDLOOP_BUILDER_MODE=

# Development browser tests only. Never set these in a production deployment.
BUILDLOOP_AUTH_MODE=
BUILDLOOP_TEST_AUTH_SECRET=
